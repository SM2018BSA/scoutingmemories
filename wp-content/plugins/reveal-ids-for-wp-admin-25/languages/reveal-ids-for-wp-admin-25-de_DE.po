#: reveal-ids-for-wp-admin-25.php:183
msgid "Enhanced by Reveal IDs Plugin"
msgstr "Erweitert durch das Reveal IDs-Plugin"

#. Author URI of the plugin
msgid "https://www.schloebe.de/"
msgstr "https://www.schloebe.de/"

#. URI of the plugin
msgid "https://www.schloebe.de/wordpress/reveal-ids-for-wp-admin-25-plugin/"
msgstr "https://www.schloebe.de/wordpress/reveal-ids-for-wp-admin-25-plugin/"

#. Author of the plugin
msgid "Oliver Schl&ouml;be"
msgstr "Oliver Schl&ouml;be"

#. Name of the plugin
msgid "Reveal IDs"
msgstr "Reveal IDs"

#. Description of the plugin
msgid ""
"Reveals hidden IDs in Admin interface that have been removed with WordPress "
"2.5 (formerly known as Entry IDs in Manage Posts/Pages View for WP 2.5)."
msgstr ""
"Zeigt in der Admin-Oberfläche versteckte IDs an, die mit WordPress 2.5 "
"entfernt wurden (früher als „Entry IDs in Manage Posts/Pages View for WP 2."
"5“ bekannt)."
