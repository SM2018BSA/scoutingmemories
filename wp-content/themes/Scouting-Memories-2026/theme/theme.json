{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "background",
					"color": "#ffffff",
					"name": "Background"
				},
				{
					"slug": "foreground",
					"color": "#404040",
					"name": "Foreground"
				},
				{
					"slug": "primary",
					"color": "#025600",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#155507",
					"name": "Secondary"
				},
				{
					"slug": "tertiary",
					"color": "#0369a1",
					"name": "Tertiary"
				}
			]
		},
		"layout": {
			"contentSize": "40rem",
			"wideSize": "60rem"
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "ui-sans-serif, system-ui, sans-serif",
					"slug": "sans",
					"name": "System Sans"
				},
				{
					"fontFamily": "\"Roboto Slab\", serif",
					"slug": "slab",
					"name": "Roboto Slab (headings)",
					"fontFace": [
						{
							"fontFamily": "Roboto Slab",
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./fonts/roboto-slab-latin-wght-normal.woff2"
							]
						}
					]
				}
			]
		}
	},
	"styles": {
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--slab)"
				}
			}
		}
	}
}
